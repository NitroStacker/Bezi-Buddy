{
  "expo": {
    "name": "Bezi Buddy",
    "slug": "bezi-buddy",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "beziremote",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.beziremote.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the private QR code displayed by your Bezi companion to pair this phone with your PC."
      }
    },
    "android": {
      "package": "app.beziremote.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1B1A19"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bezi Buddy to scan a pairing QR code from your PC."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "7c89187a-a0cf-439a-ac9c-d998688d9c5f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/7c89187a-a0cf-439a-ac9c-d998688d9c5f"
    }
  }
}
