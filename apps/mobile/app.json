{
  "expo": {
    "name": "Bezi Buddy",
    "slug": "bezi-remote",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "scheme": "beziremote",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.beziremote.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the private QR code displayed by your Bezi companion to pair this iPhone with your PC."
      }
    },
    "android": {
      "package": "app.beziremote.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1B1A19"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bezi Buddy to scan a pairing QR code from your PC."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
