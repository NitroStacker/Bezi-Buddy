# Public non-secret URL only. The owner token is entered in Settings and stored
# using SecureStore; never put it in an EXPO_PUBLIC variable.
EXPO_PUBLIC_RELAY_URL=https://bezi-remote-relay-dev.example.workers.dev
# Stage A only: the Quick Tunnel launcher generates this value in .env.local.
# Production builds must never expose an owner credential through EXPO_PUBLIC.
EXPO_PUBLIC_DEV_OWNER_TOKEN=
