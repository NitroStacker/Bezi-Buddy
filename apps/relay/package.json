{
  "name": "@bezi-remote/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --local --persist-to ../../.wrangler/state",
    "db:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bezi-remote/protocol": "workspace:*",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260729.1",
    "vitest": "3.1.1",
    "wrangler": "4.115.0"
  }
}
