{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bezi Remote Companion",
  "version": "0.1.0",
  "identifier": "app.beziremote.companion",
  "build": {
    "beforeDevCommand": "pnpm dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bezi Remote Companion",
        "width": 1024,
        "height": 720,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://* http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Securely connect your Android phone or iPhone to Bezi and Unity.",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
