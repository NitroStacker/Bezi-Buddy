<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Bezi Buddy</AssemblyName>
    <RootNamespace>BeziRemoteLauncher</RootNamespace>
    <ApplicationIcon>assets\bezi-buddy.ico</ApplicationIcon>
    <Description>Starts Bezi Buddy for Android or iPhone with Bezi and Unity.</Description>
    <Product>Bezi Buddy</Product>
    <Company>Bezi Remote</Company>
    <Version>0.2.0</Version>
  </PropertyGroup>
</Project>
